# Copy to .env, or just run ./install.sh — it creates .env and generates the
# secrets for you. Never commit the real .env.

# Static IP of this node on the emergency VLAN. Used for the operator-facing
# n8n URL; survivors reach the portal on port 80 and never need this value.
NODE_IP=192.168.1.50

# Shared by postgres, n8n and NocoDB.
POSTGRES_PASSWORD=change_me

# NocoDB session signing key. 32+ characters.
NC_AUTH_JWT_SECRET=change_me_32_characters_minimum_

# Encrypts n8n's stored credentials. If this changes, n8n can no longer decrypt
# the Triage Postgres credential and the workflow stops writing to the database.
N8N_ENCRYPTION_KEY=change_me

GENERIC_TIMEZONE=America/Chicago

# The model is NOT configured here. n8n 2.x denies Code nodes access to env vars,
# so the workflow carries it as a constant: edit DEFAULT_MODEL in
# n8n/workflows/sos-intake-triage.json and re-run install.sh, which reads that
# line and pulls the matching model.
